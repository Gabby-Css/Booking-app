# Copy this file to a new file named .env and fill in the values.
# .env is private and ignored by Git. This .env.example file is safe to commit.

PORT=3005

# Folder for the bookings.db file. Leave empty to keep it inside the app folder.
DATA_DIR=

# Opening hours are calculated in this time zone (any IANA name, e.g. Africa/Accra, Europe/London)
BUSINESS_TZ=Africa/Accra

# Name shown at the top of the page
BUSINESS_NAME=Campus Office Hours
